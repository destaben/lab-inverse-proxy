# Cloudflare Tunnel token for the lab.destaben.dev public hostname.
# Create the remotely managed tunnel and its public hostname in Cloudflare Zero
# Trust first. Keep the populated .env local and private.
CLOUDFLARE_TUNNEL_TOKEN=

# LAN address of the host that serves the Moonraker HTTP API (port 80) for the printer laboratory.
# Leave empty to keep the printer routes failing closed (502). Keep the populated value private.
PRINTER_HOST=
